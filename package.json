{
  "name": "web-extension-qa",
  "version": "1.0.0",
  "description": "Human-centered Playwright framework for Chrome extensions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README_PLAYWRIGHT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "node tests/stateless_messages/run-all-tests.js",
    "test:generic": "node tests/playwright-extension.spec.js",
    "test:worker": "node tests/stateless_messages/playwright-extension-worker-resilience.spec.js",
    "test:diagnostic": "node tests/stateless_messages/playwright-extension-diagnostic.spec.js",
    "test:library": "node tests/library_api_validation/playwright-library-api.spec.js",
    "test:fixture-cleanup": "node tests/library_api_validation/run-fixture-cleanup-validation.js",
    "test:package": "node tests/package_validation/package-consumer-smoke.js"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
